# /opt/marzban/.env  — минимальный рабочий набор для VLESS+Reality.
# Официальный установщик создаёт этот файл сам; ниже — что в нём должно быть.

## Панель управления
UVICORN_HOST = "0.0.0.0"
UVICORN_PORT = 8000
# Если хочешь панель ТОЛЬКО через SSH-туннель (безопаснее — пароль не ходит по HTTP):
# UVICORN_HOST = "127.0.0.1"
# и подключайся так:  ssh -N -L 8000:127.0.0.1:8000 root@<IP>  ->  http://127.0.0.1:8000/dashboard

## HTTPS для панели (опционально, нужен домен + сертификат)
# UVICORN_SSL_CERTFILE = "/var/lib/marzban/certs/fullchain.pem"
# UVICORN_SSL_KEYFILE  = "/var/lib/marzban/certs/key.pem"

## Свой путь к дашборду вместо /dashboard/ — снижает шанс, что панель найдут сканером
# DASHBOARD_PATH = "/kJ8sQz1x/"

## Конфиг Xray — ОБЯЗАТЕЛЬНО раскомментировать, сюда пишет 02-install-marzban.sh
XRAY_JSON = "/var/lib/marzban/xray_config.json"
XRAY_ASSETS_PATH = "/usr/local/share/xray"

## Путь к бинарнику ядра. ВНИМАНИЕ: `marzban core-update` скачивает новое ядро в
## /var/lib/marzban/xray-core/xray, но НЕ правит эту строку. Если она указывает на
## /usr/local/bin/xray (ядро из образа), обновление молча не применится: установщик
## отрапортует об успехе, а в логах останется старая версия. 05-check.sh это ловит.
XRAY_EXECUTABLE_PATH = "/var/lib/marzban/xray-core/xray"

## База (по умолчанию SQLite в /var/lib/marzban/db.sqlite3 — для личного использования хватает)
# SQLALCHEMY_DATABASE_URL = "sqlite:////var/lib/marzban/db.sqlite3"

## Подписка
XRAY_SUBSCRIPTION_URL_PREFIX = "http://ВСТАВЬ_IP:8000"
SUBSCRIPTION_PAGE_TEMPLATE = "subscription/index.html"

## Токен админа: 1440 мин = сутки
JWT_ACCESS_TOKEN_EXPIRE_MINUTES = 1440

## Telegram-бот (не нужен, оставь пустым)
# TELEGRAM_API_TOKEN =
# TELEGRAM_ADMIN_ID =

## Логи
DEBUG = false
